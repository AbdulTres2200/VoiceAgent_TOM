# Retell AI Configuration
RETELL_API_KEY=your_retell_api_key

# ServiceTitan Credentials
TENANT_ID=your_tenant_id
APP_KEY=your_app_key
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# OpenAI (for job type detection & campaign matching)
OPENAI_API_KEY=your_openai_api_key

# Google Maps API (for address validation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ServiceTitan Defaults
DEFAULT_COUNTRY=US
DEFAULT_ZIP=44094
DEFAULT_STATE=OH

# Email Configuration (optional - for notifications)
OUTLOOK_EMAIL=your_outlook_email
OUTLOOK_PASSWORD=your_outlook_app_password
